# Revive a wedged USB/Thunderbolt-dock audio DAC without sudo.
# The ThinkPad TB3 dock's USB-audio card stays enumerated after a link
# renegotiation (monitor sleep, hotplug, PD blip) but its analog output goes
# dead -- every software indicator stays green (unmuted, RUNNING, hw_ptr moving)
# while the jack is silent, and the device has no jack detection to signal the
# fault or auto-recover. Cycling the card profile off->on forces PipeWire to
# re-open the ALSA device and revives the DAC.
# See awareness-ledger INC-2026-08-20-dock-audio-dac-wedge.
dock-audio-reset() {
  local card
  card=$(pactl list short cards 2>/dev/null | awk '/Thunderbolt_3_Dock/ {print $2; exit}')
  if [ -z "$card" ]; then
    echo "dock-audio-reset: ThinkPad Thunderbolt 3 Dock audio card not found" >&2
    return 1
  fi
  echo "dock-audio-reset: cycling profile on $card ..."
  pactl set-card-profile "$card" off || return 1
  sleep 1
  pactl set-card-profile "$card" output:analog-stereo+input:mono-fallback || return 1
  echo "dock-audio-reset: dock audio re-opened."
}

# A/B the T490 internal-speaker correction against raw output, instantly (no
# restart). The default sink is the Dolby-convolver filter-chain sink
# (60-t490-speaker-tuning.conf); this flips it to the flat/untuned hardware sink
# and back so you can hear exactly what the correction does. Corrected is the
# right long-term default -- this is just an ear check.
#   speaker-ab            toggle corrected <-> raw
#   speaker-ab on|off     force corrected | raw
#   speaker-ab status     show current default sink
speaker-ab() {
  local tuned="effect_input.t490-tuned-speakers"
  local raw="alsa_output.pci-0000_00_1f.3.analog-stereo"
  local cur; cur=$(pactl get-default-sink 2>/dev/null)
  case "${1:-toggle}" in
    on|tuned)     pactl set-default-sink "$tuned" && echo "speaker-ab: CORRECTED (Dolby convolver)";;
    off|raw|flat) pactl set-default-sink "$raw"   && echo "speaker-ab: RAW (flat, untuned)";;
    status)       echo "speaker-ab: default sink = $cur";;
    toggle)
      if [ "$cur" = "$tuned" ]; then
        pactl set-default-sink "$raw"   && echo "speaker-ab: RAW (flat, untuned)"
      else
        pactl set-default-sink "$tuned" && echo "speaker-ab: CORRECTED (Dolby convolver)"
      fi;;
    *) echo "usage: speaker-ab [on|off|status|toggle]" >&2; return 1;;
  esac
}

