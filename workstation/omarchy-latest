# Bluetooth headphones (AirPods etc.): prefer AAC -- their native codec -- at VBR
# quality 5. PipeWire otherwise defaults AAC to CBR ~128kbit/s ("AAC-LQ"), which
# sounds muffled/deadpan, and a bare SBC fallback is worse. Needs libfdk-aac
# (present via pipewire's Bluetooth codec support on Arch).
cat >~/.config/wireplumber/wireplumber.conf.d/51-bluetooth-aac.conf <<'EOF'
monitor.bluez.properties = {
  bluez5.codecs = [ aac sbc_xq sbc ]
  bluez5.enable-sbc-xq = true
}
monitor.bluez.rules = [
  {
    matches = [ { device.name = "~bluez_card.*" } ]
    actions = {
      update-props = {
        # 0 = CBR (default, thin). 1-5 = VBR quality; 5 = highest.
        bluez5.a2dp.aac.bitratemode = 5
      }
    }
  }
]
EOF

