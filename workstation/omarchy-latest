# Note: Omarchy 4 replaced swayosd with its own Quickshell OSD, so no swayosd
# config is written. The volume keys below drive Omarchy's native OSD via
# omarchy-osd (see the omarchy-volume-osd wrapper further down).

# install global volume control script (affects ALL sinks and apps)
log "installing global volume control script"
mkdir -p ~/.local/bin
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/workstation/scripts/omarchy-volume" ]; then
  cp "$SCRIPT_DIR/workstation/scripts/omarchy-volume" ~/.local/bin/omarchy-volume
elif [ -f ~/.yadrlite/workstation/scripts/omarchy-volume ]; then
  cp ~/.yadrlite/workstation/scripts/omarchy-volume ~/.local/bin/omarchy-volume
else
  # Create the script inline if not found
  cat >~/.local/bin/omarchy-volume <<'VOLSCRIPT'
#!/bin/bash
# Global volume control - affects ALL sinks and streams simultaneously

ACTION="$1"
AMOUNT="${2:-5}"
MAX_VOLUME="${3:-200}"

get_all_sinks() {
    pactl list short sinks | awk '{print $1}'
}

get_all_sink_inputs() {
    pactl list short sink-inputs | awk '{print $1}'
}

get_current_volume() {
    pactl list sinks | grep -E "^\s+Volume:" | head -1 | grep -oP '\d+%' | head -1 | tr -d '%'
}

set_volume_all() {
    local vol="$1"
    if [ "$vol" -gt "$MAX_VOLUME" ]; then
        vol="$MAX_VOLUME"
    elif [ "$vol" -lt 0 ]; then
        vol=0
    fi
    for sink in $(get_all_sinks); do
        pactl set-sink-volume "$sink" "${vol}%"
    done
    for input in $(get_all_sink_inputs); do
        pactl set-sink-input-volume "$input" "${vol}%"
    done
    echo "$vol"
}

case "$ACTION" in
    raise|up|+)
        current=$(get_current_volume)
        new=$((current + AMOUNT))
        set_volume_all "$new"
        ;;
    lower|down|-)
        current=$(get_current_volume)
        new=$((current - AMOUNT))
        set_volume_all "$new"
        ;;
    mute-toggle|toggle)
        for sink in $(get_all_sinks); do
            pactl set-sink-mute "$sink" toggle
        done
        for input in $(get_all_sink_inputs); do
            pactl set-sink-input-mute "$input" toggle
        done
        ;;
    set)
        set_volume_all "$AMOUNT"
        ;;
    get)
        get_current_volume
        ;;
    balance)
        for sink in $(get_all_sinks); do
            vol=$(pactl get-sink-volume "$sink" | grep -oP '\d+%' | head -1 | tr -d '%')
            pactl set-sink-volume "$sink" "${vol}%" 2>/dev/null
        done
        for input in $(get_all_sink_inputs); do
            vol=$(pactl get-sink-input-volume "$input" 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%')
            [ -n "$vol" ] && pactl set-sink-input-volume "$input" "${vol}%" 2>/dev/null
        done
        echo "Balance fixed"
        ;;
    *)
        echo "Usage: omarchy-volume <raise|lower|mute-toggle|set|get|balance> [amount] [max-volume]"
        exit 1
        ;;
esac
VOLSCRIPT
fi
chmod +x ~/.local/bin/omarchy-volume
log "global volume control script installed"

# Volume keys: 200% max across ALL sinks/apps. Omarchy 4's native
# omarchy-audio-output-volume clamps at 100% and only touches the resolved sink,
# so we keep the custom all-sink script and override the volume keys. A tiny
# wrapper pairs the volume change with Omarchy's native OSD (omarchy-osd), which
# also keeps the Hyprland binding free of nested shell quoting under Lua.
log "installing 200% volume OSD wrapper"
cat >~/.local/bin/omarchy-volume-osd <<'OSD'
#!/bin/bash
# Adjust volume across ALL sinks/apps (200% max) and show the Omarchy native OSD.
# Usage: omarchy-volume-osd <raise|lower> [step]
dir="$1"
step="${2:-3}"

vol="$(~/.local/bin/omarchy-volume "$dir" "$step" 200 2>/dev/null | tail -1)"
[[ "$vol" =~ ^[0-9]+$ ]] || vol="$(~/.local/bin/omarchy-volume get 2>/dev/null | tail -1)"
vol="${vol:-0}"

if ((vol == 0)); then
  icon="volume-muted"
else
  icon="volume-high"
fi

omarchy-osd -i "$icon" -p "$vol"
OSD
chmod +x ~/.local/bin/omarchy-volume-osd

# Push-to-talk voice dictation (Voxtype): hold SUPER+ALT+V to speak, release to
# transcribe. Hyprland only fires a release bind when the held-modifier mask still
# matches at the instant the key goes up, so if SUPER lifts a hair before V the
# SUPER+ALT+V release misses and dictation stays engaged; the ALT+V release bind
# catches that ordering. No SUPER+V release bind — that combo is Omarchy's
# Universal paste. `voxtype record stop` is idempotent (a no-op when idle), so the
# fallback is safe. Lua config (Omarchy 4), falling back to bindings.conf.
if [ -f ~/.config/hypr/bindings.lua ]; then
  if ! grep -qF "yadrlite: voxtype push-to-talk" ~/.config/hypr/bindings.lua; then
    cat >>~/.config/hypr/bindings.lua <<'LUA'

-- yadrlite: voxtype push-to-talk — hold SUPER+ALT+V to speak, release to transcribe.
-- The ALT+V release bind is a fallback for releasing SUPER a hair before V, so
-- dictation still disengages. No SUPER+V release bind (that's Universal paste).
if o.cmd_present("voxtype") then
  o.bind("SUPER + ALT + V", "Start dictation (push-to-talk)", "voxtype record start")
  o.bind("SUPER + ALT + V", "Stop dictation (push-to-talk)", "voxtype record stop", { release = true })
  o.bind("ALT + V", "Stop dictation (SUPER released first)", "voxtype record stop", { release = true })
end
LUA
    log "voxtype push-to-talk bindings added to bindings.lua"
  fi
elif [ -f ~/.config/hypr/bindings.conf ]; then
  if ! grep -q "voxtype record start" ~/.config/hypr/bindings.conf; then
    cat >>~/.config/hypr/bindings.conf <<'EOF'

# Push-to-talk dictation (Voxtype) — hold SUPER+ALT+V to speak, release to transcribe.
# ALT+V release is a fallback for releasing SUPER before V. No SUPER+V (Universal paste).
bind = SUPER ALT, V, exec, voxtype record start
bindr = SUPER ALT, V, exec, voxtype record stop
bindr = ALT, V, exec, voxtype record stop
EOF
    log "voxtype push-to-talk bindings added to bindings.conf"
  fi
fi

# Bind the volume keys in the Lua config (Omarchy 4), falling back to
# bindings.conf on older setups.
if [ -f ~/.config/hypr/bindings.lua ]; then
  if ! grep -qF "yadrlite: 200% volume" ~/.config/hypr/bindings.lua; then
    cat >>~/.config/hypr/bindings.lua <<'LUA'

-- yadrlite: 200% volume — all sinks/apps, overriding Omarchy's 100%-capped keys.
hl.unbind("XF86AudioRaiseVolume")
hl.unbind("XF86AudioLowerVolume")
hl.unbind("ALT + XF86AudioRaiseVolume")
hl.unbind("ALT + XF86AudioLowerVolume")
o.bind("XF86AudioRaiseVolume", "Volume up", "omarchy-volume-osd raise 3", { locked = true, repeating = true })
o.bind("XF86AudioLowerVolume", "Volume down", "omarchy-volume-osd lower 3", { locked = true, repeating = true })
o.bind("ALT + XF86AudioRaiseVolume", "Volume up precise", "omarchy-volume-osd raise 1", { locked = true, repeating = true })
o.bind("ALT + XF86AudioLowerVolume", "Volume down precise", "omarchy-volume-osd lower 1", { locked = true, repeating = true })
LUA
    log "200% volume key bindings added to bindings.lua"
  fi
elif [ -f ~/.config/hypr/bindings.conf ]; then
  if ! grep -q "omarchy-volume" ~/.config/hypr/bindings.conf; then
    cat >>~/.config/hypr/bindings.conf <<'EOF'

# Volume keys with 200% max volume support - controls ALL sinks/apps globally
$osdclient = swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')"
bindeld = ,XF86AudioRaiseVolume, Volume up, exec, ~/.local/bin/omarchy-volume raise 3 200 && $osdclient --output-volume raise --max-volume 200
bindeld = ,XF86AudioLowerVolume, Volume down, exec, ~/.local/bin/omarchy-volume lower 3 200 && $osdclient --output-volume lower --max-volume 200
bindeld = ALT, XF86AudioRaiseVolume, Volume up precise, exec, ~/.local/bin/omarchy-volume raise 1 200 && $osdclient --output-volume +1 --max-volume 200
bindeld = ALT, XF86AudioLowerVolume, Volume down precise, exec, ~/.local/bin/omarchy-volume lower 1 200 && $osdclient --output-volume -1 --max-volume 200
EOF
    log "hyprland volume bindings configured for global volume control with 200% max"
  fi
fi

# Fix Lenovo dock USB autosuspend loop (VIA Labs USB 3.1 hub)
# Prevents kernel from repeatedly trying to enumerate/suspend dock ports
log "configuring lenovo dock usb fix"
if ! [ -f /etc/udev/rules.d/50-lenovo-dock.rules ]; then
  echo '# Disable autosuspend for Lenovo dock USB hub (VIA Labs)
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="17ef", ATTR{idProduct}=="307f", ATTR{power/control}="on"' | sudo tee /etc/udev/rules.d/50-lenovo-dock.rules >/dev/null
  sudo udevadm control --reload-rules
  log "lenovo dock usb udev rule installed"
fi

# Fix Realtek RTS522A card reader autosuspend (microSD not detected)
# Kernel power management suspends the PCI card reader, preventing card detection
log "configuring card reader power fix"
if ! [ -f /etc/udev/rules.d/50-realtek-card-reader.rules ]; then
  echo '# Disable autosuspend for Realtek RTS522A PCI-E card reader
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10ec", ATTR{device}=="0x522a", ATTR{power/control}="on"' | sudo tee /etc/udev/rules.d/50-realtek-card-reader.rules >/dev/null
  sudo udevadm control --reload-rules
  log "realtek card reader udev rule installed"
fi

