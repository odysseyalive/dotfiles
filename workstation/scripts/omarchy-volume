#!/bin/bash
# One-knob volume control, up to 200%.
#
# The keys move ONE volume: the physical device behind the current output. When
# the default sink is a filter-chain (the T490 speaker tuning, the dock passthrough),
# the knob is the real ALSA/Bluetooth sink it feeds, not the filter.
#
# Every other stage in the chain is held at unity (100%) on each call: filter-chain
# sinks (effect_input.*), their internal output streams (effect_output.*), and app
# streams. Those stages are in series, so setting them all to the same percent
# (what this script used to do) multiplied the attenuation: 84% on four stages was
# -18 dB, which is "near 100% and barely audible".
#
# Usage: omarchy-volume <raise|lower|set|mute-toggle|get|check|balance> [amount] [max-volume]

ACTION="$1"
AMOUNT="${2:-5}"
MAX_VOLUME="${3:-200}"

# pactl translates its output; parse it in the C locale.
export LC_ALL=C

# The physical sink behind the default output: follow effect_input.X through the
# stream effect_output.X down to the sink it plays into.
target_sink() {
    local sink virt_out id
    sink="$(pactl get-default-sink 2>/dev/null)"
    case "$sink" in
        effect_input.*)
            virt_out="effect_output.${sink#effect_input.}"
            id="$(pactl list sink-inputs | awk -v n="$virt_out" '
                /^[[:space:]]*Sink:/ {s = $2}
                $0 ~ "node.name = \"" n "\"" {print s; exit}')"
            if [ -n "$id" ]; then
                pactl list short sinks | awk -v id="$id" '$1 == id {print $2; exit}'
                return
            fi
            ;;
    esac
    echo "$sink"
}

# Hold every stage that is not the knob at unity gain.
hold_unity() {
    local name id
    pactl list short sinks | awk '$2 ~ /^effect_input\./ {print $2}' |
        while read -r name; do pactl set-sink-volume "$name" 100%; done
    pactl list short sink-inputs | awk '{print $1}' |
        while read -r id; do pactl set-sink-input-volume "$id" 100%; done
}

get_volume() {
    pactl get-sink-volume "$1" 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%'
}

set_volume() {
    local sink="$1" vol="$2"
    [ "$vol" -gt "$MAX_VOLUME" ] && vol="$MAX_VOLUME"
    [ "$vol" -lt 0 ] && vol=0
    pactl set-sink-mute "$sink" 0
    pactl set-sink-volume "$sink" "${vol}%"
    echo "$vol"
}

# Report any stage that has drifted off unity. Exit 1 if one has.
check() {
    local bad=0 line
    while read -r line; do
        echo "not at unity: $line"; bad=1
    done < <(
        pactl list sinks | awk '
            /^[[:space:]]*Name:/ {n = $2}
            /^[[:space:]]*Volume:/ && n ~ /^effect_input\./ && $0 !~ / 100% / {print "sink " n}'
        pactl list sink-inputs | awk '
            /^Sink Input #/ {id = $3}
            /^[[:space:]]*Volume:/ && $0 !~ / 100% / {print "stream " id}'
    )
    [ "$bad" -eq 0 ] && echo "ok: one knob on $(target_sink) at $(get_volume "$(target_sink)")%"
    return "$bad"
}

sink="$(target_sink)"
[ -n "$sink" ] || { echo "omarchy-volume: no default sink" >&2; exit 1; }
current="$(get_volume "$sink")"
[ -n "$current" ] || { echo "omarchy-volume: cannot read volume of $sink" >&2; exit 1; }

case "$ACTION" in
    raise|up|+)   hold_unity; set_volume "$sink" $(( current + AMOUNT )) ;;
    lower|down|-) hold_unity; set_volume "$sink" $(( current - AMOUNT )) ;;
    set)          hold_unity; set_volume "$sink" "$AMOUNT" ;;
    mute-toggle|toggle) pactl set-sink-mute "$sink" toggle ;;
    get)          echo "$current" ;;
    check)        check ;;
    balance)      set_volume "$sink" "$current" >/dev/null; echo "Balance fixed" ;;
    *)
        echo "Usage: omarchy-volume <raise|lower|set|mute-toggle|get|check|balance> [amount] [max-volume]"
        exit 1
        ;;
esac
